# Copy to .env and fill in. Never commit .env.

# Licensed data (optional; engine degrades gracefully without them)
RENTCAST_API_KEY=            # https://app.rentcast.io/app/api  (50 free calls/month)
HUD_USER_API_TOKEN=          # https://www.huduser.gov/portal/dataset/fmr-api.html

# Enrichment switches
LA_ENGINE_ENRICH=1           # 0 disables all external lookups
LA_ENGINE_CACHE_DIR=.cache/data_sources
# Override public GIS layers if an agency republishes them
# LA_COUNTY_PARCEL_LAYER=
# LA_CITY_ZONING_LAYER=
# LA_COUNTY_CITY_BOUNDARIES_LAYER=
# CAL_FIRE_FHSZ_LAYER=

# API
API_KEY=                     # when set, /deals endpoints require X-Api-Key
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./data/deals.sqlite3   # or postgresql+psycopg://user:pass@host/db
